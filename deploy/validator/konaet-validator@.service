[Unit]
Description=Konaet VLOCK validator %i
Documentation=https://github.com/7dsol3/konaet-sovereign-spec/blob/main/deploy/validator/README.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=konaet-validator
Group=konaet-validator
WorkingDirectory=/opt/konaet
Environment=NODE_ENV=production
UMask=0077
ExecStartPre=/usr/bin/node /opt/konaet/chain/scripts/runIndependentValidator.js check /var/lib/konaet/validator-%i/operator-config.json
ExecStart=/usr/bin/node /opt/konaet/chain/scripts/runIndependentValidator.js run /var/lib/konaet/validator-%i/operator-config.json
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=konaet-validator-%i
LimitNOFILE=8192
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/var/lib/konaet/validator-%i
ReadWritePaths=/var/lib/konaet/validator-%i/data

[Install]
WantedBy=multi-user.target
